generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  TECHNICIAN
  ADMIN
}

enum RequestStatus {
  REQUESTED
  CHECKED_IN
  CANCELLED
}

enum WorkOrderStatus {
  CHECKED_IN
  DIAGNOSIS
  AWAITING_APPROVAL
  APPROVED
  IN_REPAIR
  COMPLETED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  vehicles        Vehicle[]
  serviceRequests ServiceRequest[]
  assignedOrders  WorkOrder[]      @relation("TechnicianOrders")
  avatarUrl       String?
  reviewsWritten  Review[] @relation("CustomerReviews")
  reviewsReceived Review[] @relation("TechnicianReviews")
  notifications   Notification[]
}

model Vehicle {
  id        String   @id @default(cuid())
  make      String
  model     String
  year      Int
  vin       String   @unique
  mileage   Int
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  serviceRequests ServiceRequest[]
}

model ServiceRequest {
  id          String        @id @default(cuid())
  description String
  status      RequestStatus @default(REQUESTED)
  vehicleId   String
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id])
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id])
  createdAt   DateTime      @default(now())

  workOrder WorkOrder?
}

model WorkOrder {
  id               String          @id @default(cuid())
  status           WorkOrderStatus @default(CHECKED_IN)
  serviceRequestId String          @unique
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  technicianId     String?
  technician       User?           @relation("TechnicianOrders", fields: [technicianId], references: [id])
  diagnosis        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  estimate         Estimate?
  review           Review?
  parts            WorkOrderPart[]
}

enum EstimateStatus {
  PENDING
  APPROVED
  REJECTED
}

model Estimate {
  id          String         @id @default(cuid())
  workOrderId String         @unique
  workOrder   WorkOrder      @relation(fields: [workOrderId], references: [id])
  status      EstimateStatus @default(PENDING)
  items       EstimateItem[]
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?
}

model EstimateItem {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description String
  amountCents Int
}

model Review {
  id           String    @id @default(cuid())
  workOrderId  String    @unique
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id])
  customerId   String
  customer     User      @relation("CustomerReviews", fields: [customerId], references: [id])
  technicianId String
  technician   User      @relation("TechnicianReviews", fields: [technicianId], references: [id])
  rating       Int
  comment      String?
  createdAt    DateTime  @default(now())
}

model Part {
  id             String          @id @default(cuid())
  name           String          @unique
  sku            String          @unique
  unitPriceCents Int
  stock          Int
  usages         WorkOrderPart[]
}

model WorkOrderPart {
  id             String    @id @default(cuid())
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id])
  partId         String
  part           Part      @relation(fields: [partId], references: [id])
  quantity       Int
  unitPriceCents Int
  createdAt      DateTime  @default(now())
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  workOrderId String?
  message     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt])
}